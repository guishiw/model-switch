generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Upstream providers
// ---------------------------------------------------------------------------

enum ProviderType {
  OPENAI      // OpenAI + any OpenAI-compatible (Qwen/DashScope compatible mode, DeepSeek, vLLM ...)
  ANTHROPIC
  GEMINI
  OLLAMA      // OpenAI-compatible endpoint (/v1) on a local Ollama instance
}

enum ChannelStatus {
  ACTIVE
  DISABLED
  CIRCUIT_OPEN // set by the circuit breaker; auto-recovers
}

/// A channel = one upstream endpoint (base URL) with one or more API keys
model Channel {
  id            String        @id @default(cuid())
  name          String        @unique
  provider      ProviderType
  baseUrl       String
  status        ChannelStatus @default(ACTIVE)
  /// Load-balancing weight across channels serving the same public model
  weight        Int           @default(10)
  priority      Int           @default(0)
  /// Per-channel limits (0 = unlimited)
  rpmLimit      Int           @default(0)
  tpmLimit      Int           @default(0)
  maxConcurrency Int          @default(0)
  /// Extra headers to send upstream, e.g. {"OpenAI-Organization": "..."}
  extraHeaders  Json?
  /// Provider-specific config (e.g. anthropic-version, gemini apiVersion)
  config        Json?

  keys          ApiKey[]
  modelMappings ModelMapping[]
  requestLogs   RequestLog[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

/// Upstream API key belonging to a channel. Multiple keys are rotated.
model ApiKey {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// AES-256-GCM encrypted key; never returned in plaintext by the admin API
  encryptedKey String
  /// last 4 chars for display
  hint        String
  weight      Int      @default(10)
  enabled     Boolean  @default(true)
  /// auto-disabled by the balancer after auth errors / quota exhaustion
  disabledReason String?
  rpmLimit    Int      @default(0)
  tpmLimit    Int      @default(0)
  lastUsedAt  DateTime?
  failureCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channelId, enabled])
}

/// Maps a public model name (what clients send) to the upstream model on a channel.
/// e.g. publicModel="gpt-4" -> channel X, upstreamModel="my-gpt-4"
model ModelMapping {
  id            String  @id @default(cuid())
  channelId     String
  channel       Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  publicModel   String
  upstreamModel String
  enabled       Boolean @default(true)
  /// Default params merged under the request; request values win.
  paramTemplateId String?
  paramTemplate ParamTemplate? @relation(fields: [paramTemplateId], references: [id])
  /// Pricing per 1M tokens (for cost stats)
  inputPricePerM  Decimal @default(0) @db.Decimal(12, 6)
  outputPricePerM Decimal @default(0) @db.Decimal(12, 6)

  @@unique([channelId, publicModel])
  @@index([publicModel, enabled])
}

/// Named default-parameter set (temperature, max_tokens, top_p, ...)
model ParamTemplate {
  id       String  @id @default(cuid())
  name     String  @unique
  params   Json    // { "temperature": 0.7, "max_tokens": 2048, "top_p": 1 }
  mappings ModelMapping[]
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Consumers
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  /// Higher = served first from the queue (0-9)
  tier         Int       @default(0)
  tokens       AccessToken[]
  sessions     ChatSession[]
  createdAt    DateTime  @default(now())
}

/// Bearer token clients send in `Authorization: Bearer sk-...`
model AccessToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  /// sha256 hex of the raw token; raw token shown only once at creation
  tokenHash     String    @unique
  hint          String
  enabled       Boolean   @default(true)
  expiresAt     DateTime?
  /// Quotas (0 = unlimited)
  rpmLimit      Int       @default(0)
  tpmLimit      Int       @default(0)
  tokenQuota    BigInt    @default(0)  // total token budget
  tokensUsed    BigInt    @default(0)
  maxConcurrency Int      @default(0)
  /// Restrict to a set of public models (empty = all)
  allowedModels String[]  @default([])
  requestLogs   RequestLog[]
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  model     String
  /// system prompt pinned to the session
  systemPrompt String?
  /// keep the last N turns when building context (0 = all)
  contextWindow Int   @default(20)
  messages  ChatMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

enum MessageRole {
  system
  user
  assistant
  tool
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       MessageRole
  content    String
  tokenCount Int         @default(0)
  requestLogId String?
  createdAt  DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// ---------------------------------------------------------------------------
// Logs & stats
// ---------------------------------------------------------------------------

enum RequestStatus {
  SUCCESS
  FAILED
  REJECTED_RATE_LIMIT
  REJECTED_AUDIT
  QUEUE_TIMEOUT
}

model RequestLog {
  id            String        @id @default(cuid())
  requestId     String        @unique
  tokenId       String?
  token         AccessToken?  @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  channelId     String?
  channel       Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  apiKeyId      String?
  publicModel   String
  upstreamModel String?
  status        RequestStatus
  httpStatus    Int
  stream        Boolean       @default(false)
  promptTokens  Int           @default(0)
  completionTokens Int        @default(0)
  totalTokens   Int           @default(0)
  cost          Decimal       @default(0) @db.Decimal(14, 8)
  /// Total wall time incl. queue wait (ms)
  latencyMs     Int
  /// Time spent waiting in queue (ms)
  queueWaitMs   Int           @default(0)
  /// Time to first byte from upstream (ms)
  ttfbMs        Int?
  retries       Int           @default(0)
  clientIp      String?
  userAgent     String?
  errorMessage  String?
  /// Full request / response bodies (JSON). Consider retention policy.
  requestBody   Json?
  responseBody  Json?
  createdAt     DateTime      @default(now())

  @@index([createdAt])
  @@index([tokenId, createdAt])
  @@index([channelId, createdAt])
  @@index([status, createdAt])
}

/// Hourly rollups produced by the worker for dashboard charts
model UsageStatHourly {
  id           String   @id @default(cuid())
  bucket       DateTime // truncated to hour
  channelId    String?
  tokenId      String?
  publicModel  String
  requests     Int      @default(0)
  successes    Int      @default(0)
  promptTokens BigInt   @default(0)
  completionTokens BigInt @default(0)
  cost         Decimal  @default(0) @db.Decimal(14, 8)
  latencyP50   Int      @default(0)
  latencyP95   Int      @default(0)

  @@unique([bucket, channelId, tokenId, publicModel])
  @@index([bucket])
}

model AuditHit {
  id         String   @id @default(cuid())
  requestId  String
  direction  String   // "input" | "output"
  matched    String[]
  snippet    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
