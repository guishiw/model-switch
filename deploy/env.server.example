NODE_ENV=production
LOG_LEVEL=info
ADMIN_JWT_SECRET=<openssl rand -base64 48>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong password>
API_KEY_ENCRYPTION_KEY=<openssl rand -base64 32>
# MySQL 8 (special characters in the password must be URL-encoded, e.g. @ -> %40)
DATABASE_URL=mysql://user:pass@host:3306/dbname
# Direct Redis mode (password URL-encoded, e.g. ! -> %21); ignored when REDIS_SENTINELS is set
REDIS_URL=redis://:pass@host:6379/0
# Production Sentinel example (credentials are Redis data-node credentials)
# REDIS_SENTINELS=10.20.30.11:26379,10.20.30.12:26379,10.20.30.13:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_SENTINEL_USERNAME=
# REDIS_SENTINEL_PASSWORD=<sentinel password if enabled>
# REDIS_USERNAME=
# REDIS_PASSWORD=<strong password>
# REDIS_DB=0
QUEUE_PREFIX=ms
GLOBAL_MAX_CONCURRENCY=50
QUEUE_MAX_WAIT_SECONDS=60
QUEUE_PROGRESS_INTERVAL_MS=1000
ASYNC_JOB_ATTEMPTS=3
ASYNC_JOB_BACKOFF_MS=5000
UPSTREAM_TTFB_TIMEOUT_MS=60000
UPSTREAM_TOTAL_TIMEOUT_MS=600000
RELAY_MAX_RETRIES=2
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=60
AUDIT_BANNED_WORDS=
AUDIT_PROVIDER=local
