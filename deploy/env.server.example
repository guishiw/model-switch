NODE_ENV=production
LOG_LEVEL=info
ADMIN_JWT_SECRET=<openssl rand -base64 48>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong password>
API_KEY_ENCRYPTION_KEY=<openssl rand -base64 32>
PG_PASSWORD=<postgres password>
DATABASE_URL=postgresql://relay:<postgres password>@ms-postgres:5432/relay?schema=public
REDIS_URL=redis://ms-redis:6379/0
GLOBAL_MAX_CONCURRENCY=50
QUEUE_MAX_WAIT_SECONDS=60
QUEUE_PROGRESS_INTERVAL_MS=1000
UPSTREAM_TIMEOUT_MS=120000
RELAY_MAX_RETRIES=2
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=60
AUDIT_BANNED_WORDS=
AUDIT_PROVIDER=local
