# ---------- App ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Secret used to sign admin session JWTs (>= 32 chars)
ADMIN_JWT_SECRET=change-me-to-a-random-32-byte-string-please
# Initial admin credentials (used by prisma seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# AES-256-GCM key (base64, 32 bytes) for encrypting upstream API keys at rest
#   openssl rand -base64 32
API_KEY_ENCRYPTION_KEY=

# ---------- Storage ----------
DATABASE_URL=mysql://relay:relay@localhost:3306/relay
REDIS_URL=redis://localhost:6379/0
# Prefix for BullMQ keys (useful when sharing a Redis db with other apps)
QUEUE_PREFIX=ms

# ---------- Concurrency / Queue ----------
# Max in-flight upstream requests across the whole gateway
GLOBAL_MAX_CONCURRENCY=50
# Max seconds a request may wait in the queue before 429/503
QUEUE_MAX_WAIT_SECONDS=60
# Interval (ms) for pushing queue position to SSE clients
QUEUE_PROGRESS_INTERVAL_MS=1000

# ---------- Relay ----------
# Upstream timeouts (ms): time-to-first-byte, and total duration of one call (covers the whole stream)
UPSTREAM_TTFB_TIMEOUT_MS=60000
UPSTREAM_TOTAL_TIMEOUT_MS=600000
# Retry other channels on 5xx / network error
RELAY_MAX_RETRIES=2
# Circuit breaker: consecutive failures to open, and cooldown seconds
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=60

# ---------- Content audit ----------
# comma-separated banned words (simple local filter); external provider optional
AUDIT_BANNED_WORDS=
AUDIT_PROVIDER=local
